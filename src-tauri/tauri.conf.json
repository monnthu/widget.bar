{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agente Hub",
  "version": "0.1.0",
  "identifier": "com.personal.agente-hub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:43821",
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agente Hub",
        "url": "http://127.0.0.1:43821",
        "width": 445,
        "height": 700,
        "minWidth": 350,
        "minHeight": 420,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": false,
        "x": 0,
        "y": 180
      }
    ],
    "withGlobalTauri": true,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": {
      "../server/": "server/",
      "../web/": "web/"
    }
  }
}
